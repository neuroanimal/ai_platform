{
  "$defs": {
    "ActorType": {
      "enum": [
        "human",
        "model",
        "rule",
        "system",
        "external_tool",
        "unknown"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "AnalysisLayer": {
      "enum": [
        "segmentation",
        "morphology",
        "lexicon",
        "phrase_structure",
        "dependency_syntax",
        "constituency_syntax",
        "clause_structure",
        "semantics",
        "discourse",
        "pragmatics",
        "dialectology",
        "diachrony",
        "other"
      ],
      "title": "AnalysisLayer",
      "type": "string"
    },
    "AnalysisLayerExecution": {
      "additionalProperties": false,
      "description": "Execution state and diagnostics for one analysis layer.",
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "layer": {
          "$ref": "#/$defs/AnalysisLayer"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/AnalysisLayerExecutionStatus"
        }
      },
      "required": [
        "layer",
        "status"
      ],
      "title": "AnalysisLayerExecution",
      "type": "object"
    },
    "AnalysisLayerExecutionStatus": {
      "description": "Execution status of one NLP analysis layer.",
      "enum": [
        "not_started",
        "running",
        "completed",
        "failed",
        "skipped",
        "unavailable",
        "cancelled"
      ],
      "title": "AnalysisLayerExecutionStatus",
      "type": "string"
    },
    "AnalysisStatus": {
      "enum": [
        "draft",
        "completed",
        "partial",
        "failed",
        "reviewed",
        "adjudicated"
      ],
      "title": "AnalysisStatus",
      "type": "string"
    },
