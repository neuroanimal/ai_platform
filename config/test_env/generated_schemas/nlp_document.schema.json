{
  "$defs": {
    "ActorType": {
      "enum": [
        "human",
        "model",
        "rule",
        "system",
        "external_tool",
        "unknown"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "LanguageContext": {
      "additionalProperties": false,
      "description": "Language identification with optional temporal and regional scope.",
      "properties": {
        "dialect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialect"
        },
        "historical_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Historical Stage"
        },
        "language_code": {
          "minLength": 2,
          "title": "Language Code",
          "type": "string"
        },
        "linguistic_register": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linguistic Register"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "language_code"
      ],
      "title": "LanguageContext",
      "type": "object"
    },
    "OffsetUnit": {
      "enum": [
        "codepoint",
        "utf8_byte",
        "grapheme_cluster"
      ],
      "title": "OffsetUnit",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Who or what produced an annotation, and under which conditions.",
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType",
          "default": "unknown"
        },
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "provider_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Version"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "SegmentType": {
      "enum": [
        "document",
        "section",
        "chapter",
        "paragraph",
        "heading",
        "footnote",
        "caption",
        "table_cell",
        "other"
      ],
      "title": "SegmentType",
      "type": "string"
    },
    "SourceDescriptor": {
      "additionalProperties": false,
      "description": "Description of the original source, not merely its extracted text.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "creator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creator"
        },
        "date_created": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Created"
        },
        "date_range_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Range End"
        },
        "date_range_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Range Start"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "shelfmark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shelfmark"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "source_id",
        "source_type"
      ],
      "title": "SourceDescriptor",
      "type": "object"
    },
    "TextRepresentation": {
      "enum": [
        "diplomatic",
        "normalized",
        "editorial",
        "transliterated",
        "translated",
        "ocr_raw",
        "htr_raw",
        "other"
      ],
      "title": "TextRepresentation",
      "type": "string"
    },
    "TextSegment": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parent_segment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Segment Id"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "segment_type": {
          "$ref": "#/$defs/SegmentType"
        },
        "sequence_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Number"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "segment_type",
        "text"
      ],
      "title": "TextSegment",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "description": "Half-open interval [start, end) in a specific text version.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "offset_unit": {
          "$ref": "#/$defs/OffsetUnit",
          "default": "codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpan",
      "type": "object"
    },
    "TextVersion": {
      "additionalProperties": false,
      "description": "An immutable textual representation of a source document.",
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "derived_from_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From Version Id"
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "representation": {
          "$ref": "#/$defs/TextRepresentation"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/TextSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_version_id": {
          "minLength": 1,
          "title": "Text Version Id",
          "type": "string"
        },
        "transformation_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation Description"
        }
      },
      "required": [
        "text_version_id",
        "representation",
        "text"
      ],
      "title": "TextVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical document container.",
  "properties": {
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "document_language": {
      "anyOf": [
        {
          "$ref": "#/$defs/LanguageContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "primary_text_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Text Version Id"
    },
    "source": {
      "$ref": "#/$defs/SourceDescriptor"
    },
    "text_versions": {
      "items": {
        "$ref": "#/$defs/TextVersion"
      },
      "title": "Text Versions",
      "type": "array"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "document_id",
    "source"
  ],
  "title": "NLPDocument",
  "type": "object"
}
